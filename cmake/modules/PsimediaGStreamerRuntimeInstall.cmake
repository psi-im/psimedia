# Install-time part of PsimediaGStreamerRuntime.cmake. Inputs: required, optional (lists of element:plugin),
# bin_dir, plugin_dir (GStreamer SDK), dest (install directory), media_plugin (the built plugin DLL).

if(NOT IS_ABSOLUTE "${dest}")
    set(dest "${CMAKE_INSTALL_PREFIX}/${dest}")
endif()
if(DEFINED ENV{DESTDIR})
    set(dest "$ENV{DESTDIR}${dest}")
endif()

set(manifest "# GStreamer runtime installed for psimedia\n# element plugin status\n")
set(plugins)
foreach(kind required optional)
    foreach(entry IN LISTS ${kind})
        string(REPLACE ":" ";" pair "${entry}")
        list(GET pair 0 element)
        list(GET pair 1 plugin)
        if(element STREQUAL "-")
            set(element "(${plugin})")
        endif()
        set(file "${plugin_dir}/gst${plugin}.dll")
        if(EXISTS "${file}")
            list(APPEND plugins "${file}")
            string(APPEND manifest "${element} ${plugin} installed\n")
        elseif(kind STREQUAL "required")
            message(FATAL_ERROR "GStreamer plugin ${plugin} (element ${element}) is missing in ${plugin_dir}")
        else()
            message(STATUS "Optional GStreamer plugin ${plugin} (element ${element}) is not in the SDK")
            string(APPEND manifest "${element} ${plugin} absent\n")
        endif()
    endforeach()
endforeach()
list(REMOVE_DUPLICATES plugins)

if(NOT CMAKE_HOST_WIN32)
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM "windows+pe")
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL "objdump")
endif()
file(GET_RUNTIME_DEPENDENCIES
    LIBRARIES ${plugins} "${media_plugin}"
    RESOLVED_DEPENDENCIES_VAR found
    UNRESOLVED_DEPENDENCIES_VAR unresolved
    DIRECTORIES "${bin_dir}"
    PRE_EXCLUDE_REGEXES "^api-ms-" "^ext-ms-")
# Only the SDK provides the runtime: system DLLs and the Universal CRT stay out of the package.
file(TO_CMAKE_PATH "${bin_dir}" sdk_bin)
string(TOLOWER "${sdk_bin}" sdk_bin)
set(resolved)
foreach(file IN LISTS found)
    file(TO_CMAKE_PATH "${file}" path)
    get_filename_component(directory "${path}" DIRECTORY)
    string(TOLOWER "${directory}" directory)
    if(directory STREQUAL sdk_bin)
        list(APPEND resolved "${file}")
    endif()
endforeach()
set(sdk_unresolved)
foreach(name IN LISTS unresolved)
    # Unresolved names are system DLLs unless the SDK has them.
    if(EXISTS "${bin_dir}/${name}")
        list(APPEND sdk_unresolved "${name}")
    endif()
endforeach()
if(sdk_unresolved)
    message(FATAL_ERROR "Could not resolve GStreamer runtime DLLs: ${sdk_unresolved}")
endif()

file(INSTALL ${plugins} DESTINATION "${dest}/gstreamer-1.0")
file(INSTALL ${resolved} DESTINATION "${dest}")

string(APPEND manifest "# runtime DLLs\n")
list(SORT resolved)
foreach(file IN LISTS resolved)
    get_filename_component(name "${file}" NAME)
    string(APPEND manifest "${name}\n")
endforeach()
file(WRITE "${dest}/gstreamer-runtime.txt" "${manifest}")
list(LENGTH plugins plugin_count)
list(LENGTH resolved dll_count)
message(STATUS "Installed GStreamer runtime: ${plugin_count} plugins, ${dll_count} DLLs")
